CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LIBC_NEWLIB=y
CONFIG_SPI2_HOST=y
CONFIG_SCLK_GPIO=6
CONFIG_MOSI_GPIO=7
CONFIG_MISO_GPIO=8
CONFIG_CSN_GPIO=16
CONFIG_CE_GPIO=4
CONFIG_RADIO_CHANNEL=1
CONFIG_NRF24_SPI_CLOCK_HZ=500000
CONFIG_HAND_VOLTAGE_REFERENCE_MV=4140
CONFIG_HAND_VOLTAGE_READING_MV=5130
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
